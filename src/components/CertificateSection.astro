---
import '../styles/reveal.css';

const base = import.meta.env.BASE_URL;
---

<section id="certificate" class="bg-brand-ink py-24 px-6">
  <div class="max-w-3xl mx-auto">

    <div class="text-center mb-16 reveal">
      <p class="font-serif text-brand-purple text-sm tracking-[0.35em] uppercase mb-4">
        Гарантия качества
      </p>
      <h2 class="font-serif text-brand-parchment text-4xl md:text-5xl tracking-wide">
        Сертификат подлинности
      </h2>
      <div class="w-10 h-px bg-brand-gold mx-auto mt-6"></div>
      <p class="font-serif text-brand-tan text-base md:text-lg leading-relaxed mt-6">
        Каждая фигурка сопровождается именным сертификатом с автографом
        и порядковым номером из лимитированного тиража.
      </p>
    </div>

    <div
      class="relative max-w-md mx-auto group overflow-hidden rounded-sm reveal shadow-[0_0_70px_rgba(88,74,153,0.3)]"
      style="--delay:120ms"
    >
      <img
        src={`${base}certificate.webp`}
        alt="Сертификат подлинности коллекционной фигурки"
        class="w-full object-cover transition-transform duration-700 group-hover:scale-[1.02] [filter:sepia(0.25)_saturate(0.85)_brightness(0.92)]"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 ring-1 ring-brand-gold/30 pointer-events-none"></div>
      <div class="absolute inset-0 shadow-[inset_0_0_50px_30px_rgba(13,7,18,0.85)] pointer-events-none"></div>
    </div>

  </div>
</section>
