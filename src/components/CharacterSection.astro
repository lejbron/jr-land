---
import '../styles/reveal.css';

const benefits = [
  'Материализованная скульптура первого персонажа Мира Шута',
  'Ручная работа, выпущенная строго лимитированным тиражом',
  'Часть истории группы, сделанная в России',
];
---

<section
  id="character"
  class="relative min-h-screen bg-brand-void flex items-center overflow-hidden py-24"
>
  <div
    class="relative z-10 max-w-6xl mx-auto px-6 md:px-12 grid md:grid-cols-2 gap-12 md:gap-20 items-center"
  >

    <!-- Главное фото товара -->
    <div class="flex justify-center reveal">
      <div class="relative">
        <img
          src="/main.jpg"
          alt="Сказочник — коллекционная фигурка"
          class="w-full max-w-sm rounded-sm shadow-[0_0_80px_rgba(88,74,153,0.25)]"
        />
        <div class="absolute inset-0 rounded-sm ring-1 ring-brand-purple/25 pointer-events-none"></div>
      </div>
    </div>

    <!-- Текст -->
    <div class="space-y-6 reveal" style="--delay:150ms">
      <p class="font-serif text-brand-purple text-sm tracking-[0.35em] uppercase">
        О персонаже
      </p>
      <h2 class="font-serif text-brand-parchment text-4xl md:text-5xl leading-tight tracking-wide">
        Сказочник
      </h2>
      <div class="w-10 h-px bg-brand-gold"></div>
      <p class="font-serif text-brand-tan text-lg md:text-xl leading-relaxed">
        Культовый персонаж, возникший из образа зловещего колдуна. Мрачная Голова на пне,
        окружённая нечистью, превратилась в героя, объединяющего персонажей песен.
        С&nbsp;1989&nbsp;года Сказочник в разных формах появлялся в оформлении альбомов
        и атрибутики группы.
      </p>

      <ul class="pt-2 space-y-3">
        {benefits.map(b => (
          <li class="flex items-start gap-3 font-serif text-brand-parchment/80 text-base md:text-lg">
            <span class="text-brand-gold mt-1 flex-shrink-0" aria-hidden="true">✦</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>
