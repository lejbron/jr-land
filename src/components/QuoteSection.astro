---
import { readFileSync } from 'node:fs';
import { join }         from 'node:path';
import '../styles/reveal.css';

const raw = readFileSync(join(process.cwd(), '_build_data/daily_tail.md'), 'utf-8');

// Parse pairs: author line (ends with ":") followed by quoted block
interface QuoteEntry { author: string; lines: string[] }

const blocks  = raw.split(/\n{2,}/).map(b => b.trim()).filter(Boolean);
const entries: QuoteEntry[] = [];

for (let i = 0; i < blocks.length - 1; i++) {
  const maybeAuthor = blocks[i];
  const maybeQuote  = blocks[i + 1];
  if (maybeAuthor.endsWith(':') && (maybeQuote.startsWith('"') || maybeQuote.startsWith('«'))) {
    entries.push({
      author: maybeAuthor.replace(/:$/, '').trim(),
      lines:  maybeQuote.replace(/^["«]|["»]$/g, '').trim().split('\n').map(l => l.trim()).filter(Boolean),
    });
    i++; // consumed the quote block
  }
}

const entry = entries[Math.floor(Math.random() * entries.length)];
---

<section
  id="quote"
  class="min-h-[65vh] bg-brand-ink flex items-center justify-center px-8 py-24"
>
  <div class="max-w-3xl mx-auto text-center reveal">

    <div class="flex items-center gap-5 justify-center mb-12" aria-hidden="true">
      <div class="h-px bg-brand-purple/30 flex-1 max-w-24"></div>
      <span class="font-serif text-brand-purple/40 text-lg">✦</span>
      <div class="h-px bg-brand-purple/30 flex-1 max-w-24"></div>
    </div>

    <blockquote class="font-serif italic text-brand-parchment/90 text-2xl md:text-[2.5rem] leading-relaxed md:leading-[1.4]">
      {entry.lines.map((line, i) => (
        <>
          {line}
          {i < entry.lines.length - 1 && <br />}
        </>
      ))}
    </blockquote>

    <div class="flex items-center gap-5 justify-center mt-10" aria-hidden="true">
      <div class="h-px bg-brand-purple/30 flex-1 max-w-24"></div>
      <p class="font-serif text-brand-purple/50 text-xs tracking-[0.3em] uppercase whitespace-nowrap">
        {entry.author}
      </p>
      <div class="h-px bg-brand-purple/30 flex-1 max-w-24"></div>
    </div>

  </div>
</section>
