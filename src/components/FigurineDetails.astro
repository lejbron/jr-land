---
import '../styles/reveal.css';

const boxContents = [
  'Премиальная упаковка в авторском стиле',
  'Уникальная фигурка с одним из трёх видов серёжек',
  'Один из четырёх видов стикерпаков',
  'Сертификат подлинности с автографом',
  'Карточка с технической информацией',
];
---

<section id="details" class="bg-brand-ink py-24 px-6">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 md:gap-20 items-start">

    <!-- Процесс создания -->
    <div class="space-y-5 reveal">
      <h3 class="font-serif text-brand-parchment text-2xl md:text-3xl tracking-wide">
        Процесс создания
      </h3>
      <p class="font-serif text-brand-tan text-base md:text-lg leading-relaxed">
        Фигурка напечатана на 3D&#8209;принтере из фотополимерной смолы. Каждый экземпляр
        вручную обработан и покрашен акриловыми красками с финишным покрытием лаком.
      </p>
      <p class="font-serif text-brand-tan/60 text-sm tracking-wide">
        Требует бережного хранения. Не игрушка. Всего будет выпущено 250 штук.
      </p>

      <!-- Анимация: сумка с молниями -->
      <div class="pt-4 reveal" style="--delay:100ms">
        <div
          id="lightning-bag"
          style="position:relative;width:100%;max-width:340px;aspect-ratio:520/470;overflow:hidden;cursor:pointer;background:transparent;user-select:none;"
        >
          <div class="lb-ground" style="position:absolute;left:50%;bottom:9%;width:46%;height:9%;transform:translateX(-50%);background:radial-gradient(ellipse at center, rgba(0,0,0,0.55), rgba(0,0,0,0) 70%);filter:blur(6px);pointer-events:none;opacity:0;"></div>

          <img
            class="lb-bag"
            src="/bag.svg"
            alt="Упаковка"
            draggable="false"
            style="position:absolute;left:50%;top:8%;width:62%;transform:translateX(-50%);animation:lb-breathe 6s ease-in-out infinite;pointer-events:none;"
          />

          <svg class="lb-bolts" viewBox="0 0 91.65 89.29" style="position:absolute;left:50%;top:8%;width:62%;transform:translateX(-50%);overflow:visible;pointer-events:none;">
            <defs>
              <filter id="lb-glow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur in="SourceAlpha" stdDeviation="1.5" result="b"></feGaussianBlur>
                <feFlood id="lb-flood" flood-color="#a78bfa" flood-opacity="0.95" result="c"></feFlood>
                <feComposite in="c" in2="b" operator="in" result="halo"></feComposite>
                <feMerge>
                  <feMergeNode in="halo"></feMergeNode>
                  <feMergeNode in="halo"></feMergeNode>
                  <feMergeNode in="SourceGraphic"></feMergeNode>
                </feMerge>
              </filter>
            </defs>

