---
import Layout           from '../layouts/Layout.astro';
import HeroSection      from '../components/HeroSection.astro';
import CharacterSection from '../components/CharacterSection.astro';
import QuoteSection     from '../components/QuoteSection.astro';
import FigurineSection  from '../components/FigurineSection.astro';
import FigurineDetails  from '../components/FigurineDetails.astro';
import SiteFooter       from '../components/SiteFooter.astro';
import CookieBanner     from '../components/CookieBanner.astro';
import '../styles/global.css';
---

<Layout title="Сказочник — Мир Шута | Коллекционная фигурка">
  <HeroSection />       <!-- Блок 1: занавес -->
  <CharacterSection />  <!-- Блок 2: история персонажа -->
  <QuoteSection />      <!-- Блок 3: случайная цитата -->
  <FigurineSection />   <!-- Блок 4: три фото -->
  <FigurineDetails />   <!-- Блок 5: производство + состав -->
  <SiteFooter />
  <CookieBanner />
</Layout>

<script>
  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
  const observer  = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  revealEls.forEach(el => observer.observe(el));
</script>
